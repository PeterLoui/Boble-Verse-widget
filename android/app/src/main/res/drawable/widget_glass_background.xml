<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's RemoteViews (المستخدمة في ويدجتس الشاشة الرئيسية) ما بتدعمش
  Real-time Gaussian Blur زي داخل التطبيق نفسه. أقرب حاجة لإحساس "الزجاج"
  هي: خلفية شبه شفافة + تدرج لوني + حواف دائرية + طبقة حدود فاتحة.
  ده بيدي إحساس Liquid Glass حتى لو مش Blur حقيقي بالكامل.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#14FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
